# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Replace with your MongoDB Atlas connection string or local MongoDB URI
MONGODB_URI=mongodb://127.0.0.1:27017/mixerfix

# JWT Authentication
JWT_SECRET=mixer_fix_jwt_super_secret_key_2026_production_grade
JWT_EXPIRES_IN=7d

# CORS Client URL
CLIENT_URL=http://localhost:5173

# File Upload Directory
UPLOAD_DIR=uploads
MAX_FILE_SIZE=25000000

# Nodemailer Email Notifications (Optional)
EMAIL_SERVICE=gmail
EMAIL_USER=notifications@mixerfix.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM=Mixer Fix Notifications <notifications@mixerfix.com>
