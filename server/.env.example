# Server Environment Configuration (Render / Production)
PORT=10000
HOST=0.0.0.0
NODE_ENV=production

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mixerfix?retryWrites=true&w=majority
MONGODB_URI=

# JWT Authentication
JWT_SECRET=your_jwt_strong_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# CORS Allowed Client URLs (Vercel Frontend URL)
# Example: https://mixer-fix.vercel.app,http://localhost:5173
CLIENT_URL=https://your-frontend.vercel.app

# File Upload Directory
UPLOAD_DIR=uploads
MAX_FILE_SIZE=25000000

# Nodemailer Email Notifications (Optional)
EMAIL_SERVICE=gmail
EMAIL_USER=notifications@mixerfix.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM=Mixer Fix Notifications <notifications@mixerfix.com>

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
